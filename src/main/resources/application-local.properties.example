# Copy to application-local.properties and replace every placeholder for this machine.
# This example deliberately contains no real account or service credentials.
spring.datasource.url=jdbc:mysql://localhost:3306/web_sach_cu?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
spring.datasource.username=root
spring.datasource.password=YOUR_LOCAL_MYSQL_PASSWORD

# Replace with a randomly generated value of at least 32 characters.
jwt.secret=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Optional integrations: fill these only when testing email or media upload.
spring.mail.username=YOUR_EMAIL_ADDRESS
spring.mail.password=YOUR_GMAIL_APP_PASSWORD
cloudinary.cloud-name=YOUR_CLOUD_NAME
cloudinary.api-key=YOUR_CLOUDINARY_API_KEY
cloudinary.api-secret=YOUR_CLOUDINARY_API_SECRET

# Keep false unless intentionally resetting demo account passwords locally.
app.demo-accounts.reset-passwords=false
