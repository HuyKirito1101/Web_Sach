<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="title" value="Danh Mục - Manager" scope="request" />
<jsp:include page="../../common/header.jsp" />
<div class="d-flex"><jsp:include page="../../common/sidebar.jsp" /><div class="flex-grow-1"><jsp:include page="../../common/navbar.jsp" />
<div class="main-content container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4"><h3 class="fw-bold mb-0"><i class="fa-solid fa-list-check text-primary me-2"></i>Quản Lý Danh Mục</h3><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#categoryModal"><i class="fa-solid fa-plus me-1"></i>Thêm danh mục</button></div>
    <c:if test="${not empty successMessage}"><div class="alert alert-success">${successMessage}</div></c:if><c:if test="${not empty errorMessage}"><div class="alert alert-danger">${errorMessage}</div></c:if>
    <div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>ID</th><th>Tên</th><th>Slug</th><th>Mô tả</th><th>Trạng thái</th><th></th></tr></thead><tbody>
    <c:forEach var="item" items="${categories}"><tr><td>${item.id}</td><td class="fw-bold">${item.name}</td><td><code>${item.slug}</code></td><td>${item.description}</td><td><span class="badge ${item.active ? 'bg-success' : 'bg-secondary'}">${item.active ? 'HIỂN THỊ' : 'ẨN'}</span></td><td class="text-end"><form action="/manager/categories/${item.id}/delete" method="post" onsubmit="return confirm('Xóa danh mục này?')"><button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button></form></td></tr></c:forEach>
    </tbody></table></div></div>
</div></div></div>
<div class="modal fade" id="categoryModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form action="/manager/categories/save" method="post"><div class="modal-header"><h5 class="modal-title fw-bold">Thêm danh mục</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="mb-3"><label class="form-label">Tên danh mục</label><input name="name" class="form-control" required></div><div class="mb-3"><label class="form-label">Mô tả</label><textarea name="description" class="form-control" rows="3"></textarea></div><div class="form-check"><input type="checkbox" name="active" value="true" checked class="form-check-input" id="managerCategoryActive"><label class="form-check-label" for="managerCategoryActive">Hiển thị</label></div></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary">Lưu</button></div></form></div></div></div>
<jsp:include page="../../common/footer.jsp" />
