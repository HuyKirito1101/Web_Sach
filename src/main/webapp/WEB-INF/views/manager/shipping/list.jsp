<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="title" value="Vận Chuyển - Manager" scope="request" /><jsp:include page="../../common/header.jsp" />
<div class="d-flex"><jsp:include page="../../common/sidebar.jsp" /><div class="flex-grow-1"><jsp:include page="../../common/navbar.jsp" /><div class="main-content container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4"><h3 class="fw-bold mb-0"><i class="fa-solid fa-truck-fast text-primary me-2"></i>Nhà Vận Chuyển</h3><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#shippingModal"><i class="fa-solid fa-plus me-1"></i>Thêm đơn vị</button></div>
    <c:if test="${not empty successMessage}"><div class="alert alert-success"><c:out value="${successMessage}"/></div></c:if><c:if test="${not empty errorMessage}"><div class="alert alert-danger"><c:out value="${errorMessage}"/></div></c:if>
    <div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Tên</th><th>Mã</th><th>Dịch vụ</th><th>Thời gian</th><th>Hotline</th><th>Phí cơ bản</th><th>Trạng thái</th><th></th></tr></thead><tbody>
    <c:forEach var="p" items="${providers}"><tr><td class="fw-bold">${p.name}</td><td>${p.code}</td><td>${p.serviceType}</td><td>${p.estimatedDays}</td><td>${p.phone}</td><td class="text-success fw-bold"><fmt:formatNumber value="${p.baseFee}" pattern="#,##0 ₫" /></td><td><span class="badge ${p.active ? 'bg-success' : 'bg-secondary'}">${p.active ? 'HOẠT ĐỘNG' : 'TẠM DỪNG'}</span></td><td class="text-end"><form action="/manager/shipping/${p.id}/delete" method="post" onsubmit="return confirm('Xóa nhà vận chuyển này?')"><button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button></form></td></tr></c:forEach>
    </tbody></table></div></div>
</div></div></div>
<div class="modal fade" id="shippingModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form action="/manager/shipping/save" method="post"><div class="modal-header"><h5 class="modal-title fw-bold">Thêm nhà vận chuyển</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="mb-3"><label class="form-label">Tên đơn vị</label><input name="name" class="form-control" required></div><div class="row"><div class="col-6 mb-3"><label class="form-label">Mã</label><input name="code" class="form-control" placeholder="GHN_STANDARD"></div><div class="col-6 mb-3"><label class="form-label">Hotline</label><input name="phone" class="form-control"></div></div><div class="mb-3"><label class="form-label">Loại dịch vụ</label><input name="serviceType" class="form-control"></div><div class="mb-3"><label class="form-label">Thời gian dự kiến</label><input name="estimatedDays" class="form-control" placeholder="2-4 ngày"></div><div class="mb-3"><label class="form-label">Phí cơ bản</label><input type="number" min="0" name="baseFee" value="25000" class="form-control" required></div><div class="form-check"><input type="checkbox" name="active" value="true" checked class="form-check-input" id="managerShippingActive"><label for="managerShippingActive" class="form-check-label">Hoạt động</label></div></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary">Lưu</button></div></form></div></div></div>
<jsp:include page="../../common/footer.jsp" />
