<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="title" value="Dashboard Shipper" scope="request"/><jsp:include page="../common/header.jsp"/><div class="d-flex"><jsp:include page="../common/sidebar.jsp"/><div class="flex-grow-1"><jsp:include page="../common/navbar.jsp"/><main class="main-content container-fluid">
<div class="d-flex justify-content-between align-items-start mb-4"><div><h3 class="fw-bold mb-1">Dashboard Shipper</h3><p class="text-muted">Thống kê các đơn được phân công cho bạn</p></div><form class="d-flex gap-2"><input class="form-control" type="date" name="from" value="${from}"><input class="form-control" type="date" name="to" value="${to}"><button class="btn btn-primary">Lọc</button></form></div>
<div class="row g-3 mb-4"><div class="col-md-2"><div class="card card-stat p-3"><small class="text-muted">TỔNG ĐƠN</small><h3>${stats.total}</h3></div></div><div class="col-md-2"><div class="card card-stat p-3"><small class="text-muted">CHỜ NHẬN</small><h3>${stats.assigned}</h3></div></div><div class="col-md-2"><div class="card card-stat p-3"><small class="text-muted">ĐANG GIAO</small><h3>${stats.inProgress}</h3></div></div><div class="col-md-2"><div class="card card-stat p-3"><small class="text-muted">THÀNH CÔNG</small><h3 class="text-success">${stats.delivered}</h3></div></div><div class="col-md-2"><div class="card card-stat p-3"><small class="text-muted">THẤT BẠI</small><h3 class="text-danger">${stats.failed}</h3></div></div><div class="col-md-2"><div class="card card-stat p-3"><small class="text-muted">TIỀN COD THU HỘ</small><h5 class="text-primary"><fmt:formatNumber value="${stats.totalCodCollected}" pattern="#,#00 ₫"/></h5></div></div></div>
<div class="card border-0 shadow-sm"><div class="card-header bg-white d-flex justify-content-between"><h5>Đơn gần đây</h5><a href="/shipper/orders">Xem tất cả</a></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Mã đơn</th><th>Người nhận</th><th>Địa chỉ</th><th>Trạng thái</th></tr></thead><tbody><c:forEach var="a" items="${recentAssignments}"><tr><td><a href="/shipper/orders/${a.id}">${a.order.orderCode}</a></td><td>${a.order.receiverName}<div class="small text-muted">${a.order.receiverPhone}</div></td><td>${a.order.shippingAddress}</td><td><span class="badge bg-info text-dark">${a.status}</span></td></tr></c:forEach><c:if test="${empty recentAssignments}"><tr><td colspan="4" class="text-center text-muted py-4">Chưa được phân công đơn</td></tr></c:if></tbody></table></div></div>
</main></div></div><jsp:include page="../common/footer.jsp"/>
