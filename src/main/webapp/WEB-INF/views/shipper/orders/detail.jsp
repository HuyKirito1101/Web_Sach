<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="title" value="Chi tiết giao hàng" scope="request"/><jsp:include page="../../common/header.jsp"/><div class="d-flex"><jsp:include page="../../common/sidebar.jsp"/><div class="flex-grow-1"><jsp:include page="../../common/navbar.jsp"/><main class="main-content container-fluid">
<a href="/shipper/orders" class="btn btn-link px-0">← Danh sách đơn giao</a><div class="d-flex justify-content-between mb-4"><div><h3 class="fw-bold">${assignment.order.orderCode}</h3><span class="badge bg-info text-dark">${assignment.status}</span></div><h4><fmt:formatNumber value="${assignment.order.finalAmount}" pattern="#,#00 ₫"/></h4></div>
<c:if test="${not empty successMessage}"><div class="alert alert-success">${successMessage}</div></c:if><c:if test="${not empty errorMessage}"><div class="alert alert-danger">${errorMessage}</div></c:if>
<div class="row g-3"><div class="col-lg-7"><div class="card border-0 shadow-sm"><div class="card-body"><h5>Thông tin giao nhận</h5><dl class="row mb-0"><dt class="col-sm-4">Cửa hàng</dt><dd class="col-sm-8">${assignment.order.branch.name}</dd><dt class="col-sm-4">Địa chỉ lấy</dt><dd class="col-sm-8">${assignment.order.branch.address}</dd><dt class="col-sm-4">Người nhận</dt><dd class="col-sm-8">${assignment.order.receiverName}</dd><dt class="col-sm-4">Điện thoại</dt><dd class="col-sm-8"><a href="tel:${assignment.order.receiverPhone}">${assignment.order.receiverPhone}</a></dd><dt class="col-sm-4">Địa chỉ giao</dt><dd class="col-sm-8">${assignment.order.shippingAddress}</dd><dt class="col-sm-4">Ghi chú</dt><dd class="col-sm-8">${assignment.note}</dd><c:if test="${not empty assignment.failureReason}"><dt class="col-sm-4 text-danger">Lý do thất bại</dt><dd class="col-sm-8 text-danger">${assignment.failureReason}</dd></c:if></dl></div></div></div>
<div class="col-lg-5"><div class="card border-0 shadow-sm"><div class="card-body"><h5>Cập nhật giao hàng</h5>
<c:if test="${assignment.status == 'ASSIGNED'}"><form method="post" action="/shipper/orders/${assignment.id}/status" class="d-grid gap-2"><button name="status" value="ACCEPTED" class="btn btn-outline-primary">Xác nhận nhận phân công</button><button name="status" value="PICKED_UP" class="btn btn-primary">Đã lấy hàng</button></form></c:if>
<c:if test="${assignment.status == 'ACCEPTED'}"><form method="post" action="/shipper/orders/${assignment.id}/status"><button name="status" value="PICKED_UP" class="btn btn-primary w-100">Đã lấy hàng</button></form></c:if>
<c:if test="${assignment.status == 'PICKED_UP'}"><form method="post" action="/shipper/orders/${assignment.id}/status"><button name="status" value="SHIPPING" class="btn btn-warning w-100">Bắt đầu giao</button></form></c:if>
<c:if test="${assignment.status == 'SHIPPING'}"><form method="post" action="/shipper/orders/${assignment.id}/status" class="mb-3"><button name="status" value="DELIVERED" class="btn btn-success w-100">Giao thành công</button></form></c:if>
<c:if test="${assignment.status == 'PICKED_UP' || assignment.status == 'SHIPPING'}"><form method="post" action="/shipper/orders/${assignment.id}/status"><input type="hidden" name="status" value="FAILED"><label class="form-label">Lý do giao thất bại</label><textarea class="form-control mb-2" name="failureReason" required></textarea><button class="btn btn-outline-danger w-100">Báo giao thất bại</button></form></c:if>
<c:if test="${assignment.status == 'DELIVERED' || assignment.status == 'FAILED' || assignment.status == 'CANCELLED'}"><div class="alert alert-secondary mb-0">Đơn giao đã kết thúc ở trạng thái ${assignment.status}.</div></c:if>
</div></div></div></div>
</main></div></div><jsp:include page="../../common/footer.jsp"/>
