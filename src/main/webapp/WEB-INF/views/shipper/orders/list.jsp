<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="title" value="Đơn giao của Shipper" scope="request"/><jsp:include page="../../common/header.jsp"/><div class="d-flex"><jsp:include page="../../common/sidebar.jsp"/><div class="flex-grow-1"><jsp:include page="../../common/navbar.jsp"/><main class="main-content container-fluid">
<h3 class="fw-bold mb-4">Đơn được phân công</h3><form class="row g-2 mb-4"><div class="col-md-3"><select class="form-select" name="status"><option value="">Tất cả trạng thái</option><c:forEach var="s" items="${statuses}"><option value="${s}" ${selectedStatus == s ? 'selected' : ''}>${s}</option></c:forEach></select></div><div class="col-md-3"><input class="form-control" type="date" name="from" value="${from}"></div><div class="col-md-3"><input class="form-control" type="date" name="to" value="${to}"></div><div class="col-md-3"><button class="btn btn-primary">Lọc</button></div></form>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Đơn hàng</th><th>Cửa hàng</th><th>Người nhận</th><th>Địa chỉ</th><th>Phân công</th><th>Trạng thái</th></tr></thead><tbody><c:forEach var="a" items="${assignments}"><tr><td><a class="fw-bold" href="/shipper/orders/${a.id}">${a.order.orderCode}</a><div class="small text-muted"><fmt:formatNumber value="${a.order.finalAmount}" pattern="#,#00 ₫"/></div></td><td>${a.order.branch.name}</td><td>${a.order.receiverName}<div class="small text-muted">${a.order.receiverPhone}</div></td><td>${a.order.shippingAddress}</td><td>${a.assignedAt}</td><td><span class="badge ${a.status == 'DELIVERED' ? 'bg-success' : (a.status == 'FAILED' ? 'bg-danger' : 'bg-info text-dark')}">${a.status}</span></td></tr></c:forEach><c:if test="${empty assignments}"><tr><td colspan="6" class="text-center text-muted py-4">Không có đơn phù hợp</td></tr></c:if></tbody></table></div></div>
</main></div></div><jsp:include page="../../common/footer.jsp"/>
