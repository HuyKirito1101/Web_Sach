<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="title" value="Chi tiết đơn Vendor" scope="request"/><jsp:include page="../../common/header.jsp"/><div class="d-flex"><jsp:include page="../../common/sidebar.jsp"/><div class="flex-grow-1"><jsp:include page="../../common/navbar.jsp"/><main class="main-content container-fluid">
<a href="/vendor/orders" class="btn btn-link px-0">← Quay lại</a><h3 class="fw-bold mb-4">Đơn ${order.orderCode}</h3><div class="row g-3"><div class="col-lg-4"><div class="card border-0 shadow-sm"><div class="card-body"><h5>Thông tin giao hàng</h5><p class="mb-1"><strong>${order.receiverName}</strong></p><p class="mb-1">${order.receiverPhone}</p><p>${order.shippingAddress}</p><span class="badge bg-info">${order.orderStatus}</span></div></div></div><div class="col-lg-8"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Sản phẩm</th><th>Tình trạng</th><th>SL</th><th>Đơn giá</th></tr></thead><tbody><c:forEach var="i" items="${items}"><tr><td>${i.bookCopy.book.title}</td><td>${i.bookCopy.conditionRating}</td><td>${i.quantity}</td><td><fmt:formatNumber value="${i.price}" pattern="#,#00 ₫"/></td></tr></c:forEach></tbody></table></div></div></div></div>
</main></div></div><jsp:include page="../../common/footer.jsp"/>
