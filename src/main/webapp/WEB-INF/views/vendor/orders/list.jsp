<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="title" value="Đơn hàng Vendor" scope="request"/><jsp:include page="../../common/header.jsp"/><div class="d-flex"><jsp:include page="../../common/sidebar.jsp"/><div class="flex-grow-1"><jsp:include page="../../common/navbar.jsp"/><main class="main-content container-fluid">
<div class="d-flex justify-content-between mb-4"><h3 class="fw-bold">Đơn hàng cửa hàng</h3><form><select name="status" class="form-select" onchange="this.form.submit()"><option value="">Tất cả trạng thái</option><c:forEach var="s" items="${statuses}"><option value="${s}" ${selectedStatus == s ? 'selected' : ''}>${s}</option></c:forEach></select></form></div>
<c:if test="${not empty successMessage}"><div class="alert alert-success">${successMessage}</div></c:if><c:if test="${not empty errorMessage}"><div class="alert alert-danger">${errorMessage}</div></c:if>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Mã đơn</th><th>Người nhận</th><th>Tổng tiền</th><th>Thanh toán</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="o" items="${orders}"><tr><td><a href="/vendor/orders/${o.id}" class="fw-bold">${o.orderCode}</a></td><td>${o.receiverName}<div class="small text-muted">${o.receiverPhone}</div></td><td><fmt:formatNumber value="${o.finalAmount}" pattern="#,#00 ₫"/></td><td>${o.paymentMethod} / ${o.paymentStatus}</td><td><span class="badge bg-info text-dark">${o.orderStatus}</span></td><td><form method="post" action="/vendor/orders/${o.id}/status" class="d-flex gap-1">
<c:if test="${o.orderStatus == 'NEW'}"><button name="status" value="CONFIRMED" class="btn btn-sm btn-success">Xác nhận</button><button name="status" value="CANCELLED" class="btn btn-sm btn-outline-danger">Hủy</button></c:if>
<c:if test="${o.orderStatus == 'CONFIRMED'}"><button name="status" value="PACKING" class="btn btn-sm btn-primary">Chuẩn bị</button><button name="status" value="READY_FOR_PICKUP" class="btn btn-sm btn-warning">Sẵn sàng lấy</button></c:if>
<c:if test="${o.orderStatus == 'PACKING'}"><button name="status" value="READY_FOR_PICKUP" class="btn btn-sm btn-warning">Sẵn sàng lấy</button></c:if>
</form></td></tr></c:forEach><c:if test="${empty orders}"><tr><td colspan="6" class="text-center text-muted py-4">Không có đơn hàng</td></tr></c:if></tbody></table></div></div>
</main></div></div><jsp:include page="../../common/footer.jsp"/>
