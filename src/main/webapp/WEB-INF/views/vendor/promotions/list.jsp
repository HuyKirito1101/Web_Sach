<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="title" value="Khuyến mãi Vendor" scope="request"/><jsp:include page="../../common/header.jsp"/><div class="d-flex"><jsp:include page="../../common/sidebar.jsp"/><div class="flex-grow-1"><jsp:include page="../../common/navbar.jsp"/><main class="main-content container-fluid">
<div class="d-flex justify-content-between mb-4"><h3 class="fw-bold">Khuyến mãi cửa hàng</h3><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#promotionModal">Tạo chương trình</button></div><c:if test="${not empty successMessage}"><div class="alert alert-success">${successMessage}</div></c:if><c:if test="${not empty errorMessage}"><div class="alert alert-danger">${errorMessage}</div></c:if>
<div class="card border-0 shadow-sm"><table class="table align-middle mb-0"><thead><tr><th>Tên</th><th>Giảm</th><th>Thời gian</th><th>Trạng thái</th><th></th></tr></thead><tbody><c:forEach var="p" items="${promotions}"><tr><td>${p.title}</td><td>${p.discountPercent}%</td><td>${p.startDate} - ${p.endDate}</td><td><span class="badge ${p.active ? 'bg-success' : 'bg-secondary'}">${p.active ? 'ACTIVE' : 'PAUSED'}</span></td><td><form method="post" action="/vendor/promotions/${p.id}/delete"><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa chương trình này?')">Xóa</button></form></td></tr></c:forEach><c:if test="${empty promotions}"><tr><td colspan="5" class="text-center text-muted py-4">Chưa có khuyến mãi</td></tr></c:if></tbody></table></div>
<div class="modal fade" id="promotionModal"><div class="modal-dialog"><form class="modal-content" method="post" action="/vendor/promotions/save"><div class="modal-header"><h5 class="modal-title">Tạo khuyến mãi</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">Tên</label><input class="form-control mb-3" name="title" required><label class="form-label">Phần trăm giảm</label><input class="form-control mb-3" type="number" name="discountPercent" min="0.01" max="100" step="0.01" required><div class="row"><div class="col"><label class="form-label">Bắt đầu</label><input class="form-control" type="date" name="startDate" required></div><div class="col"><label class="form-label">Kết thúc</label><input class="form-control" type="date" name="endDate" required></div></div><div class="form-check mt-3"><input class="form-check-input" type="checkbox" name="active" value="true" checked><label class="form-check-label">Kích hoạt</label></div></div><div class="modal-footer"><button class="btn btn-primary">Lưu</button></div></form></div></div>
</main></div></div><jsp:include page="../../common/footer.jsp"/>
