<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="title" value="Thu mua sách cũ" scope="request"/><jsp:include page="../../common/header.jsp"/><div class="d-flex"><jsp:include page="../../common/sidebar.jsp"/><div class="flex-grow-1"><jsp:include page="../../common/navbar.jsp"/><main class="main-content container-fluid">
<div class="d-flex justify-content-between mb-4"><h3 class="fw-bold">Yêu cầu thu mua sách cũ</h3><form><select class="form-select" name="status" onchange="this.form.submit()"><option value="">Tất cả</option><c:forEach var="s" items="${statuses}"><option value="${s}" ${selectedStatus == s ? 'selected' : ''}>${s}</option></c:forEach></select></form></div><c:if test="${not empty successMessage}"><div class="alert alert-success">${successMessage}</div></c:if><c:if test="${not empty errorMessage}"><div class="alert alert-danger">${errorMessage}</div></c:if>
<div class="row g-3"><c:forEach var="r" items="${requests}"><div class="col-lg-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="d-flex justify-content-between"><h5>Yêu cầu #${r.id}</h5><span class="badge bg-info text-dark">${r.status}</span></div><p class="small text-muted">Khách: ${r.customer.fullName} - ${r.customer.phone}</p><p>${r.note}</p><p>Kỳ vọng: <fmt:formatNumber value="${r.expectedTotal}" pattern="#,#00 ₫"/> | Đề nghị: <fmt:formatNumber value="${r.offeredTotal}" pattern="#,#00 ₫"/></p><form method="post" action="/vendor/sell-requests/${r.id}/status"><div class="row g-2"><div class="col-md-4"><select class="form-select" name="status" required><option value="INSPECTING">Kiểm định</option><option value="QUOTED">Báo giá</option><option value="ACCEPTED">Chấp nhận</option><option value="REJECTED">Từ chối</option><option value="COMPLETED">Hoàn tất</option></select></div><div class="col-md-3"><input class="form-control" type="number" min="0" name="offeredTotal" placeholder="Giá đề nghị"></div><div class="col-md-3"><input class="form-control" name="staffNote" placeholder="Ghi chú"></div><div class="col-md-2"><button class="btn btn-primary w-100">Lưu</button></div></div></form></div></div></div></c:forEach><c:if test="${empty requests}"><div class="col-12"><div class="alert alert-light text-center">Chưa có yêu cầu thu mua</div></div></c:if></div>
</main></div></div><jsp:include page="../../common/footer.jsp"/>
